# ---- Docker Compose でのデプロイ時に必須（docs/deploy.md 参照）----
# DB コンテナのパスワード。openssl rand -hex 16 などで生成する
POSTGRES_PASSWORD=
# 公開ドメイン（standalone プロファイル利用時。例: line.example.com）
DOMAIN=

# DB 接続（Docker Compose 利用時は無視される。ローカル開発時のみ設定）
DATABASE_URL=postgres://user:pass@localhost:5432/cocotte_vert

# LINE Messaging API（テスト用チャネルの値を入れる。本番値をここに書かない）
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=

# LIFF（Phase 2 から使用）
LIFF_ID=
# ID トークン検証用チャネル ID。通常は LIFF_ID の先頭部分から自動導出されるため空で可
LIFF_CHANNEL_ID=

# スタッフ通知の送信先: slack | line | both（デフォルト: slack）
# line を含める場合は STAFF_LINE_GROUP_ID が必須。
# 注意: LINE グループへの通知は1件につき通数を1消費する（グループ宛は人数に関わらず1通）
STAFF_NOTIFY_CHANNEL=slack
# スタッフ用 LINE グループの ID（通常は空で可）。
# Bot をグループに招待すると自動で通知先に設定される。手動で固定したい場合のみ指定
STAFF_LINE_GROUP_ID=

# Slack Incoming Webhook（STAFF_NOTIFY_CHANNEL に slack を含む場合に必須）
SLACK_WEBHOOK_URL=

# Claude API（Phase 4 から使用）
ANTHROPIC_API_KEY=

# 送信モード: dry_run | test | live
# live は環境変数ファイルに書かず、実行時に明示的に渡す運用とする
SEND_MODE=dry_run
# SEND_MODE=test のときの送信先 LINE userId（U で始まる33文字）。
# 専用アカウントは不要で、店長・スタッフ本人の LINE でよい。ただし運用中の
# 公式アカウントを友だち追加している必要がある（userId はアカウントごとに違うため）。
# 値は友だち追加後に SELECT line_user_id FROM customers ... で取り出す
TEST_LINE_USER_ID=

DORMANT_DAILY_LIMIT=50
# 配信の起点となる日数（他店舗へ展開するとき、コードを触らず店舗ごとに変えられる）
PRE_REMINDER_DAYS_BEFORE=2
AFTER_VISIT_DAYS_AFTER=7
DORMANT_DAYS=90
# 誕生日クーポンの URL（LINE 公式アカウントのクーポン機能で作成。空なら文面のみ）
BIRTHDAY_COUPON_URL=
# 月間通数の残りが上限の何割を切ったら警告するか（既定 0.1 = 残り10%）。
# 割合判定なのでプラン変更時の設定変更は不要
# （ライト5,000通→残り500 / スタンダード30,000通→残り3,000で警告）
QUOTA_WARN_RATIO=0.1
# 割合ではなく通数で固定したい場合のみ指定（設定するとこちらが優先される）
QUOTA_WARN_REMAINING=

# Instagram 投稿（管理画面の SNS 投稿。未設定なら機能ごと無効）
# 設定手順は docs/instagram.md を参照。トークンは60日有効で、アプリが自動延長する
# IG_USER_ID は空でよい（トークンからアカウントが特定されるため）
IG_USER_ID=
IG_ACCESS_TOKEN=
# dry_run（既定・実投稿しない） | live（実際に投稿する）
IG_POST_MODE=dry_run

# スレッズ投稿（同じ SNS 投稿画面から。未設定なら機能ごと無効）
# 設定手順は docs/threads.md を参照。Instagram とは別のトークンを使う
# THREADS_USER_ID は空でよい（トークンからアカウントが特定されるため）
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=
# dry_run（既定・実投稿しない） | live（実際に投稿する）
THREADS_POST_MODE=dry_run

# Instagram・スレッズは投稿画像を公開URLから取得する。通常は DOMAIN から自動導出されるため空で可
PUBLIC_BASE_URL=

# 店舗プロフィール（未設定なら「ここっとベール」の値になる）。
# 他店舗へ展開するときは、index.html ではなくここを書き換える。
# 手順は docs/new-store.md を参照。配色だけは CSS 変数の直接編集が必要
STORE_NAME=
STORE_TAGLINE=
# サイドバーのロゴ。絵文字1文字
STORE_LOGO=
STORE_OPEN_TIME=10:00
STORE_CLOSE_TIME=19:00
# 定休日。曜日名で複数可（例: 火,水）。空にすると定休日なし
STORE_CLOSED_DAYS=木
# 店舗情報カードに出す。空なら行ごと表示しない
STORE_ADDRESS=
STORE_PHONE=

# 管理画面（/admin）の Basic 認証。未設定なら管理画面は無効
ADMIN_USER=
ADMIN_PASSWORD=
# 外部予約システム取り込み API の Bearer トークン。未設定なら取り込み API は無効
# openssl rand -hex 24 などで生成する
INGEST_API_TOKEN=
TZ=Asia/Tokyo
PORT=3000
